# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: model to use (default: openai/gpt-4o-mini)
# See https://openrouter.ai/models for available models
# LLM_MODEL=openai/gpt-4o-mini
# LLM_MODEL=anthropic/claude-3-haiku

# Supabase: project URL and anon (public) key from Project Settings > API
# If not set, the app uses in-memory stores (data lost on restart).
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_KEY=your-anon-key

# Superuser: comma-separated emails allowed to access /admin dashboard
# SUPERUSER_EMAILS=admin@example.com,superuser@example.com
# Optional: set a password to auto-create superuser accounts on startup (so you can log in without registering first)
# ADMIN_BOOTSTRAP_PASSWORD=your-secure-password
